Cell[BoxData[{
 RowBox[{
  SubscriptBox["\[Delta]", 
   RowBox[{"a_", ",", "b_"}]], ":=", 
  RowBox[{"KroneckerDelta", "[", 
   RowBox[{"a", ",", "b"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  SubscriptBox["A", 
   RowBox[{"x_", ",", "a_"}]], ":=", 
  RowBox[{
   RowBox[{
    SubscriptBox["\[Delta]", 
     RowBox[{"x", ",", "0"}]], 
    SubscriptBox["\[Delta]", 
     RowBox[{"a", ",", "0"}]], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], "+", 
   RowBox[{
    SubscriptBox["\[Delta]", 
     RowBox[{"x", ",", "0"}]], 
    SubscriptBox["\[Delta]", 
     RowBox[{"a", ",", "1"}]], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], " ", "+", " ", 
   RowBox[{
    SubscriptBox["\[Delta]", 
     RowBox[{"x", ",", "1"}]], 
    SubscriptBox["\[Delta]", 
     RowBox[{"a", ",", "0"}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"1", "/", "2"}], "*", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], ")"}]}], "+", 
   RowBox[{
    SubscriptBox["\[Delta]", 
     RowBox[{"x", ",", "1"}]], 
    SubscriptBox["\[Delta]", 
     RowBox[{"a", ",", "1"}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"1", "/", "2"}], "*", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], 
     ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CC", "[", 
   RowBox[{"i_", ",", "j_", ",", "q_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"1", "/", "4"}], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["A", 
       RowBox[{"0", ",", "i"}]], "+", 
      SubscriptBox["A", 
       RowBox[{"1", ",", "j"}]]}], ")"}]}], "-", 
   RowBox[{
    FractionBox["q", "4"], 
    RowBox[{"(", 
     RowBox[{"2", "-", 
      SubscriptBox["\[Delta]", 
       RowBox[{"i", ",", "2"}]], "-", 
      SubscriptBox["\[Delta]", 
       RowBox[{"j", ",", "2"}]]}], ")"}], 
    RowBox[{"IdentityMatrix", "[", "2", "]"}], " "}]}]}]}], "Input",
