 RowBox[{
  SubscriptBox["A", 
   RowBox[{"x_", ",", "a_"}]], ":=", 
  RowBox[{
   RowBox[{
    SubscriptBox["\[Delta]", 
     RowBox[{"x", ",", "0"}]], 
    SubscriptBox["\[Delta]", 
     RowBox[{"a", ",", "0"}]], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], "+", 
   RowBox[{
    SubscriptBox["\[Delta]", 
