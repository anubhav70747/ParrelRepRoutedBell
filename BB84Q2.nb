    SubscriptBox["\[Delta]", 
     RowBox[{"x", ",", "1"}]], 
    SubscriptBox["\[Delta]", 
     RowBox[{"a", ",", "0"}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"1", "/", "2"}], "*", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], ")"}]}], "+", 
   RowBox[{
    SubscriptBox["\[Delta]", 
     RowBox[{"x", ",", "1"}]], 
    SubscriptBox["\[Delta]", 
     RowBox[{"a", ",", "1"}]], 
    RowBox[{"(", 
