Cell[BoxData[
 RowBox[{
  RowBox[{"CC", "[", 
   RowBox[{"i_", ",", "j_", ",", "k_", ",", "l_", ",", "q_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"1", "/", "16"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubsuperscriptBox["\[Sum]", 
        RowBox[{"a", "=", "0"}], "1"], 
       RowBox[{
        SubsuperscriptBox["\[Sum]", 
         RowBox[{"b", "=", "0"}], "1"], 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Delta]", 
           RowBox[{"i", ",", 
            RowBox[{
             RowBox[{"2", "a"}], "+", "b"}]}]], 
          SubscriptBox["A2", 
           RowBox[{"0", ",", "0", ",", "a", ",", "b"}]]}], ")"}]}]}], "+", 
      RowBox[{
       SubsuperscriptBox["\[Sum]", 
        RowBox[{"a", "=", "0"}], "1"], 
       RowBox[{
        SubsuperscriptBox["\[Sum]", 
         RowBox[{"b", "=", "0"}], "1"], 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Delta]", 
           RowBox[{"j", ",", 
            RowBox[{
             RowBox[{"2", "a"}], "+", "b"}]}]], 
          SubscriptBox["A2", 
           RowBox[{"0", ",", "1", ",", "a", ",", "b"}]]}], ")"}]}]}], "+", 
      RowBox[{
       SubsuperscriptBox["\[Sum]", 
        RowBox[{"a", "=", "0"}], "1"], 
       RowBox[{
        SubsuperscriptBox["\[Sum]", 
         RowBox[{"b", "=", "0"}], "1"], 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Delta]", 
           RowBox[{"k", ",", 
            RowBox[{
             RowBox[{"2", "a"}], "+", "b"}]}]], 
          SubscriptBox["A2", 
           RowBox[{"1", ",", "0", ",", "a", ",", "b"}]]}], ")"}]}]}], "+", 
      RowBox[{
       SubsuperscriptBox["\[Sum]", 
        RowBox[{"a", "=", "0"}], "1"], 
       RowBox[{
        SubsuperscriptBox["\[Sum]", 
         RowBox[{"b", "=", "0"}], "1"], 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Delta]", 
           RowBox[{"l", ",", 
            RowBox[{
             RowBox[{"2", "a"}], "+", "b"}]}]], 
          SubscriptBox["A2", 
           RowBox[{"1", ",", "1", ",", "a", ",", "b"}]]}], ")"}]}]}]}], 
     ")"}]}], "-", 
   RowBox[{
    FractionBox["q", "16"], 
    RowBox[{"(", 
     RowBox[{"4", "-", 
      SubscriptBox["\[Delta]", 
       RowBox[{"i", ",", "4"}]], "-", 
      SubscriptBox["\[Delta]", 
       RowBox[{"j", ",", "4"}]], "-", 
      SubscriptBox["\[Delta]", 
       RowBox[{"k", ",", "4"}]], "-", 
      SubscriptBox["\[Delta]", 
       RowBox[{"l", ",", "4"}]]}], ")"}], 
    RowBox[{"IdentityMatrix", "[", "4", "]"}], " "}]}]}]], "Input",
