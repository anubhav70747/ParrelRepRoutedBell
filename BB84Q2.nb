Cell[BoxData[{
 RowBox[{
  RowBox[{"a_", "\[CircleDot]", "b_"}], ":=", 
  RowBox[{"KroneckerProduct", "[", 
   RowBox[{"a", ",", "b"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  SubscriptBox["A2", 
   RowBox[{"x0_", ",", "x1_", ",", "a0_", ",", "a1_"}]], ":=", 
  RowBox[{
   SubscriptBox["A", 
    RowBox[{"x0", ",", "a0"}]], "\[CircleDot]", " ", 
